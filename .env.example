# ==========================================
# SUPABASE CONNECTION TEMPLATE
# ==========================================
# 1. Create a project at https://supabase.com
# 2. Project Settings -> Data API / API Keys
# 3. Copy the values below, then rename this file to ".env"
# 4. Never commit the real ".env" file to git.

# Project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=

# Public anon / publishable key (safe to expose in the browser)
VITE_SUPABASE_ANON_KEY=

# Optional: override the full Edge Function endpoint.
# Leave empty to use ${VITE_SUPABASE_URL}/functions/v1/api automatically.
VITE_API_URL=
